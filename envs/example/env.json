{
  "schema": 2,
  "environment": "example",
  "pvwa_url": "https://pvwa.example.com",
  "enduser": {
    "name": "psm-test-user",
    "auth_method": "LDAP",
    "ccp": {
      "url": "https://ccp.example.com",
      "app_id": "PSM-HealthTest",
      "safe": "PSMTestUser",
      "object": "psm-test-user"
    }
  },
  "defaults": {
    "psm_server": "psm01.example.com"
  },
  "target": {
    "account_safe": "TestTargets"
  },
  "allowed_components": [
    "PSM-RDP",
    "PSM-SSH",
    "PSM-WinScp",
    "PSM-WebApp"
  ],
  "prompt_defaults": {
    "PSM-RDP": {
      "after_sec": 10,
      "count": 1,
      "key": "Enter"
    },
    "PSM-SSH": {
      "after_sec": 10,
      "count": 1,
      "key": "Enter"
    },
    "PSM-WinScp": {
      "after_sec": 20,
      "count": 1,
      "key": "Enter"
    },
    "PSM-WebApp": {
      "after_sec": 10,
      "count": 1,
      "key": "Enter"
    }
  },
  "test": {
    "hold_seconds": 150,
    "recording_wait_seconds": 120,
    "check_recording": true,
    "check_window_titles": true,
    "min_recording_percent": 0,
    "reason": "automated psm health test"
  },
  "window_titles": {
    "error_anywhere": [
      "Dispatcher error message",
      "Fatal Error"
    ],
    "error_if_last": [
      "Warning",
      "Security Alert"
    ]
  },
  "prechecks": {
    "enabled": true,
    "tcp_port": 3389
  },
  "reliability": {
    "retries": 1,
    "retry_wait_sec": 60,
    "alert_after_failures": 1,
    "max_run_minutes": 60,
    "heartbeat_hours": 6
  },
  "credentials": {
    "ccp": {
      "client_certificate_thumbprint": "",
      "windows_integrated": false
    }
  },
  "screenshots": {
    "mode": "failures",
    "interval_sec": 5,
    "max_mail_kb": 3000
  },
  "outputs": {
    "json": true,
    "history": true,
    "keep_days": 30,
    "screenshot_keep_days": 7,
    "eventlog": false,
    "webhook_url": ""
  },
  "mail": {
    "smtp_host": "mail.example.com",
    "smtp_port": 25,
    "from": "psm-health@example.com",
    "to": [
      "ops-alerts@example.com"
    ],
    "send_on": "failure",
    "repeat_hours": 6,
    "dry_run": true,
    "subject_prefix": "[PSM health]"
  }
}